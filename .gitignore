# Dependencies
node_modules/

# Next.js build output
.next/
out/

# Downloaded source data caches (e.g. Ontario SIF XLSX for build-schools-dataset)
.cache/

# Phase 2 geo "Things to Know" — downloaded/converted rail+transit source data.
# Reproduce via docs/geo-data-sources.md; never commit the raw/large data.
data/_geo_src/
data/orwn_track.geojson
data/transit_stations.geojson

# Zoning overlay — harvested municipal zoning polygons (~300MB across all sources).
# Reproduce via scripts/admin/harvest-*-zoning.mjs; the live overlay reads PostGIS
# (loaded by scripts/admin/load-zoning.ts). Never commit the raw/large data.
scripts/admin/zoning-*.geojson
# dev_application harvest output — reproduce via scripts/admin/harvest-toronto-dev-apps.mjs
scripts/admin/dev-apps-*.geojson
# major_construction harvest output — reproduce via scripts/admin/harvest-toronto-permits.mjs
scripts/admin/permits-*.geojson

