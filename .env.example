# Database — direct Postgres connection string (used by scripts/admin migration runners)
DATABASE_URL="postgresql://user:password@localhost:5432/realestate"

# Supabase (auth + data). The URL + anon key are public (NEXT_PUBLIC_); the service
# role key is server/ETL-only and bypasses RLS — never expose it to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Typesense (search). Admin key is server/ETL-only; search-only key is public.
TYPESENSE_ADMIN_API_KEY="your-typesense-admin-key"
NEXT_PUBLIC_TYPESENSE_SEARCH_ONLY_API_KEY="your-typesense-search-only-key"

# Resend (watchlist alert emails — scripts/worker/alerts.ts). Optional locally;
# the alert job no-ops without RESEND_API_KEY. ALERTS_FROM_EMAIL must be on a
# Resend-verified domain. NEXT_PUBLIC_SITE_URL is used to build links in emails.
RESEND_API_KEY="your-resend-api-key"
ALERTS_FROM_EMAIL="PureProperty Alerts <alerts@pureproperty.ca>"
NEXT_PUBLIC_SITE_URL="https://pureproperty.ca"
# Where listing "Schedule Viewing" leads are emailed (/api/viewing-requests).
# Falls back to ALERTS_FROM_EMAIL if unset. Set in the runtime env (Railway).
VIEWING_REQUESTS_EMAIL="blackj8591@gmail.com"

# VOW API (PROPTX)
VOW_API_URL="https://api.proptx.com/vow"
VOW_API_KEY="your-vow-api-key"
VOW_CLIENT_ID="your-client-id"
VOW_CLIENT_SECRET="your-client-secret"

# Mapbox — powers the terminal map, the commute-zone isochrone (/api/isochrone),
# and the destination geocoder (/api/geocode). One token covers all three.
NEXT_PUBLIC_MAPBOX_TOKEN="your-mapbox-token"

# Ampre API (https://developer.ampre.ca/docs/getting-started)
AMPRE_API_URL="https://query.ampre.ca/odata"
AMPRE_ACCESS_TOKEN="your-ampre-access-token"

# Feature flags
# VOW Terms-of-Use enforcement. When "true" (and migration 029 is applied), signed-in
# users must accept the VOW Terms via the one-time /welcome screen before any VOW data is
# served; the dashboard and market APIs gate on it. Defaults to OFF when unset — only the
# literal "true" enables it (see src/lib/auth/terms.ts). Set in the runtime env (Railway)
# to activate production.
VOW_ENFORCE_TERMS="true"
